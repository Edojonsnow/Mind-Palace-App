APP_NAME="Mind Palace App"
APP_ENV=staging
APP_VERSION=0.1.0
DATABASE_URL="postgresql://user:password@staging-branch-host/neondb?sslmode=require&channel_binding=require"
NEON_AUTH_JWKS_URL=https://<auth-host>/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://<auth-host>
NEON_AUTH_AUDIENCE=
BACKEND_CORS_ORIGINS=https://staging.mindpalace.example
OPENAI_API_KEY=
REDIS_URL=redis://localhost:6379/0
