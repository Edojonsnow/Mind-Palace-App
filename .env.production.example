APP_NAME="Mind Palace App"
APP_ENV=production
APP_VERSION=0.1.0
DATABASE_URL="postgresql://user:password@production-branch-host/neondb?sslmode=require&channel_binding=require"
NEON_AUTH_JWKS_URL=https://<auth-host>/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://<auth-host>
NEON_AUTH_AUDIENCE=<audience-claim-from-neon-auth>
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_AUTH_BRANCH_ID=
NEON_MANAGEMENT_API_BASE_URL=https://console.neon.tech/api/v2
BACKEND_CORS_ORIGINS=https://mindpalace.example
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_METADATA_MODEL=gpt-4.1-mini
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
AI_QUEUE_NAME=mind-palace-ai
AI_CHUNK_SIZE_CHARS=1600
AI_CHUNK_OVERLAP_CHARS=200
AI_RECONCILIATION_INTERVAL_SECONDS=30
AI_RECONCILIATION_BATCH_SIZE=50
AI_JOB_STALE_AFTER_SECONDS=900
AI_QUEUE_RETRY_DELAY_SECONDS=60
ACCOUNT_DELETION_RECONCILIATION_BATCH_SIZE=50
ACCOUNT_DELETION_RETRY_MAX=5
ACCOUNT_DELETION_RETRY_INTERVAL_SECONDS=300
ASK_TOP_K=5
ASK_HISTORY_MESSAGES=10
ASK_MAX_CONTEXT_CHARS=12000
RECOVERY_WINDOW_DAYS=60
EXPORT_RETENTION_HOURS=24
IDEMPOTENCY_RETENTION_HOURS=24
RATE_LIMITS_ENABLED=true
RATE_LIMIT_ASK_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_ORGANIZE_PER_MINUTE=10
RATE_LIMIT_EXPORTS_PER_HOUR=3
RATE_LIMIT_AI_JOBS_PER_MINUTE=20
RATE_LIMIT_THOUGHT_WRITES_PER_MINUTE=60
RATE_LIMIT_BOOK_WRITES_PER_MINUTE=20
RATE_LIMIT_PROFILE_WRITES_PER_MINUTE=20
RATE_LIMIT_SETTINGS_WRITES_PER_MINUTE=20
RATE_LIMIT_ACCOUNT_DELETION_PER_HOUR=5
AUTH_RATE_LIMITS_ENABLED=true
AUTH_RATE_LIMIT_TOKEN=<shared-secret-with-web>
AUTH_RATE_LIMIT_SIGN_UP_PER_WINDOW=5
AUTH_RATE_LIMIT_SIGN_IN_PER_WINDOW=10
AUTH_RATE_LIMIT_VERIFICATION_PER_WINDOW=5
AUTH_RATE_LIMIT_PASSWORD_RESET_PER_WINDOW=5
AI_QUOTAS_ENABLED=true
AI_DAILY_QUOTA_UNITS=200
AI_QUOTA_ASK_UNITS=2
AI_QUOTA_SEARCH_UNITS=1
AI_QUOTA_ORGANIZATION_UNITS=2
AI_MAX_THOUGHT_CHARS=50000
