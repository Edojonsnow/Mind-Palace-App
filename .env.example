APP_NAME="Mind Palace App"
APP_ENV=local
APP_VERSION=0.1.0
DATABASE_URL=postgresql://user:password@localhost:5432/mind_palace
NEON_AUTH_JWKS_URL=https://<auth-host>/neondb/auth/.well-known/jwks.json
NEON_AUTH_ISSUER=https://<auth-host>
NEON_AUTH_AUDIENCE=
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_METADATA_MODEL=gpt-4.1-mini
OPENAI_ANSWER_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
REDIS_URL=redis://localhost:6379/0
AI_QUEUE_NAME=mind-palace-ai
AI_CHUNK_SIZE_CHARS=1600
AI_CHUNK_OVERLAP_CHARS=200
ASK_TOP_K=5
ASK_HISTORY_MESSAGES=10
ASK_MAX_CONTEXT_CHARS=12000
RECOVERY_WINDOW_DAYS=30
EXPORT_RETENTION_HOURS=24
